# iCloud Email MCP Server Configuration

# Your iCloud email address (Apple ID)
# Example: your-email@icloud.com
ICLOUD_EMAIL=

# App-specific password for iCloud Mail access
# IMPORTANT: This is NOT your regular iCloud password!
# Generate an app-specific password at: https://appleid.apple.com
# Navigate to: Sign-In and Security > App-Specific Passwords
# Your Apple ID must have two-factor authentication enabled
ICLOUD_PASSWORD=

# Hosted multiuser server (go run ./cmd/mail); keep these private.
MAIL_BASE_URL=https://mail.microapps.space
MAIL_ADDR=127.0.0.1:4290
MAIL_POSTGRES_URI=postgres://mail:PASSWORD@127.0.0.1:5432/mail
# Generate once with: openssl rand -base64 32. Back this up with the database.
MAIL_ENCRYPTION_KEY=
# Microapps ID sign-in (the only login). Register the app with redirect URI
# https://mail.microapps.space/api/auth/id/callback
MAIL_ID_ISSUER=https://id.microapps.space
MAIL_ID_CLIENT_ID=
MAIL_ID_CLIENT_SECRET=
# Optional central app-access enforcement; requires confidential credentials.
# Keep false until reviewed provider grants and per-app cutover are complete.
MAIL_ID_ACCESS_ENABLED=false
# Independent random 32-byte key: openssl rand -base64 32 (not the encryption key)
MAIL_ID_COOKIE_KEY=
